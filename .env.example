# PRESS'D environment variables — placeholders only. Never commit real values.
# Set these in Vercel → Project → Settings → Environment Variables.
# All of them are server-side only (none use the NEXT_PUBLIC_ prefix).

# ---------------------------------------------------------------- public site (existing)
# Google rating and reviews on the About section (Places API, server-side).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# ---------------------------------------------------------------- SEO Studio (/admin/seo)
# Verified production origin the crawler and PageSpeed tests are restricted to.
SEO_SITE_URL=https://www.pressdcafe.ae

# Postgres (Neon via the Vercel Marketplace). Then run: npm run db:migrate
DATABASE_URL=

# Who may sign in, with a role each: viewer | editor | publisher | admin
# e.g. SEO_ADMIN_USERS=owner@example.com:admin, seo@agency.example:publisher
SEO_ADMIN_USERS=

# Encrypts session cookies. At least 32 characters: openssl rand -base64 48
SEO_SESSION_SECRET=

# Google OAuth client (Google sign-in + read-only Search Console).
# Redirect URI must be exactly: https://www.pressdcafe.ae/api/admin/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://www.pressdcafe.ae/api/admin/auth/google/callback

# Encrypts stored Search Console tokens (AES-256-GCM). 32 bytes, base64: openssl rand -base64 32
SEO_TOKEN_ENCRYPTION_KEY=

# Optional but recommended: without it PageSpeed uses Google's shared anonymous quota (often refused).
PAGESPEED_INSIGHTS_API_KEY=
